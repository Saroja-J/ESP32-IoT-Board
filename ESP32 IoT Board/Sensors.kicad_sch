	(text "* BME280 is a digital humidity,pressure and temprature sensor.\n* operating vg: 1.71 to 3.6V(VDD) and 1.2 to 3.6(VDDIO).\n* All passive component values are selected as \n  reccomended in the datasheet.\n* I2C mode: CSB=High"
		(exclude_from_sim no)
		(at 47.244 35.052 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 52 46 255 1)
			)
			(justify left)
		)
		(uuid "856f53c4-7ea3-48c8-b178-3835c2262ab1")
	)
	(text "* The CMC-5044PF-A electric microphone converts sound waves \n  into a small analog electrical signal and MAX4466EXK amplifies \n  this signal to a level suitable for the ESP32 ADC.\n* operating vg: +2.4V to +5V.\n* All passive component values are selected as \n  reccomended in the datasheet.\n"
		(exclude_from_sim no)
		(at 193.548 95.758 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 52 46 255 1)
			)
			(justify left)
		)
		(uuid "ca6b2948-2d04-4def-b66e-143fb8d48663")
	)
